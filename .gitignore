# ==============================================================================
# Git Ignore Configuration
# ==============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
.venv/
env/
venv/
ENV/

# Installer & Test logs
pip-log.txt
pip-delete-this-directory.txt
htmlcov/
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.pytest_cache/
.mypy_cache/

# Translations
*.mo
*.pot

# Logs, Databases & Local MLflow Runs
*.log
*.db
*.rdb
mlflow.db
mlruns/
.dvc/cache
.dvc/tmp

# Secrets & DotEnv configuration (NEVER COMMIT CREDENTIALS)
.env
.env.*
.env.fd
.streamlit/secrets.toml

# IDE & Editor Configurations
.idea/
.vscode/
.spyproject/
*.swp
*.swo

# Jupyter Notebook Checkpoints
.ipynb_checkpoints/
**/.ipynb_checkpoints/

# Operating System Files
.DS_Store
Thumbs.db
ehthumbs.db

# Deployment Artifacts & Scratch Scripts
deployment.zip
test_*.py

# ── DVC & Data Artifacts ──────────────────────────────────────────────────────
# Ignore raw & processed dataset files, but keep .dvc files and gitkeeps
backend/data/**
!backend/data/**/*.dvc
!backend/data/**/.gitignore
!backend/data/**/.gitkeep
!backend/src/data/**

# Ignore serialized models and preprocessors (managed via DVC / MLflow)
**/models/*.joblib
**/models/*.pkl
!**/models/.gitignore
!**/models/.gitkeep

**/artifacts/*.joblib
**/artifacts/*.pkl
!**/artifacts/.gitkeep

# Ignore generated diagnostics plots output
**/reports/diagnostics/

# Ignore transient MLflow pipeline orchestration state
**/reports/active_pipeline_run.json
backend/src/data/__pycache__/data_cleaning.cpython-311.pyc
